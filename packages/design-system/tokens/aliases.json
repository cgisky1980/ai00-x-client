{
  "$description": "Ai00-X 设计令牌 · alias（别名层：key 本身就是完整 token 路径，1:1 直出 CSS 变量名）。两类用途：1) 纯跨引用别名（如 radius.sm → size.radius.sm，兼容 web-ui ThemeService 现有变量名）；2) “基名与子名冲突”的 token（如 --color-accent 既是独立变量又是 --color-accent-500 的基名，JSON 树中 color.accent 是分组，故基名在此声明）。别名关系在数据里，不在构建代码里（规范 3.2）。",
  "alias": {
    "color.primary": { "$value": "{color.accent.500}", "$type": "color", "$description": "主色别名（mixin 兼容）" },
    "color.primary-hover": { "$value": "{color.accent.600}", "$type": "color" },
    "color.accent": { "$value": "{color.accent.500}", "$type": "color", "$description": "基名与色阶分组冲突，在此声明" },
    "color.accent-primary": { "$value": "{color.accent.500}", "$type": "color" },
    "color.success": { "$value": "{color.success.solid}", "$type": "color", "$description": "基名与 .bg/.border 子名冲突，引用 solid（随主题切换）" },
    "color.warning": { "$value": "{color.warning.solid}", "$type": "color" },
    "color.error": { "$value": "{color.error.solid}", "$type": "color" },
    "color.info": { "$value": "{color.info.solid}", "$type": "color" },
    "color.highlight": { "$value": "{color.highlight.solid}", "$type": "color" },

    "border.hover": { "$value": "{border.medium}", "$type": "color" },
    "border.focus": { "$value": "{border.strong}", "$type": "color" },
    "border.accent": { "$value": "{border.accent.solid}", "$type": "color", "$description": "基名与 .soft/.subtle/.strong 子名冲突，引用 solid" },
    "border.purple": { "$value": "{border.purple.solid}", "$type": "color" },

    "card.bg": { "$value": "{element.bg.base}", "$type": "color", "$description": "基名与 card.bg.* 子名冲突，在此声明" },
    "card.border": { "$value": "{border.base}", "$type": "color" },
    "card.border-hover": { "$value": "{border.medium}", "$type": "color" },
    "card.border-active": { "$value": "{color.accent.300}", "$type": "color" },

    "git.color.branch": { "$value": "{git.color.branch.solid}", "$type": "color", "$description": "基名与 .bg/.border 子名冲突，引用 solid" },
    "git.color.changes": { "$value": "{git.color.changes.solid}", "$type": "color" },
    "git.color.staged": { "$value": "{git.color.staged.solid}", "$type": "color" },
    "git.color.deleted": { "$value": "{git.color.deleted.solid}", "$type": "color" },
    "git.color.added": { "$value": "{git.color.staged}", "$type": "color" },
    "git.color.added-bg": { "$value": "{git.color.staged.bg}", "$type": "color" },
    "git.color.added-bg-hover": { "$value": "{git.color.staged.bg-hover}", "$type": "color" },
    "git.color.pull": { "$value": "{git.color.branch}", "$type": "color" },
    "git.color.pull-bg": { "$value": "{git.color.branch.bg}", "$type": "color" },
    "git.color.pull-bg-hover": { "$value": "{git.color.branch.bg-hover}", "$type": "color" },
    "git.color.push": { "$value": "{git.color.staged}", "$type": "color" },
    "git.color.push-bg": { "$value": "{git.color.staged.bg}", "$type": "color" },
    "git.color.push-bg-hover": { "$value": "{git.color.staged.bg-hover}", "$type": "color" },

    "z.modal": { "$value": "10000", "$type": "number", "$description": "基名与 z.modal.active 子名冲突，在此声明" },

    "radius.sm": { "$value": "{size.radius.sm}", "$type": "dimension", "$description": "ThemeService 兼容名" },
    "radius.base": { "$value": "{size.radius.base}", "$type": "dimension" },
    "radius.lg": { "$value": "{size.radius.lg}", "$type": "dimension" },
    "radius.xl": { "$value": "{size.radius.xl}", "$type": "dimension" },
    "radius.2xl": { "$value": "{size.radius.2xl}", "$type": "dimension" },
    "radius.full": { "$value": "{size.radius.full}", "$type": "dimension" },

    "spacing.1": { "$value": "{size.gap.1}", "$type": "dimension", "$description": "ThemeService 兼容名" },
    "spacing.2": { "$value": "{size.gap.2}", "$type": "dimension" },
    "spacing.3": { "$value": "{size.gap.3}", "$type": "dimension" },
    "spacing.4": { "$value": "{size.gap.4}", "$type": "dimension" },
    "spacing.5": { "$value": "{size.gap.5}", "$type": "dimension" },
    "spacing.6": { "$value": "{size.gap.6}", "$type": "dimension" },
    "spacing.8": { "$value": "{size.gap.8}", "$type": "dimension" },
    "spacing.10": { "$value": "{size.gap.10}", "$type": "dimension" },
    "spacing.12": { "$value": "{size.gap.12}", "$type": "dimension" },
    "spacing.16": { "$value": "{size.gap.16}", "$type": "dimension" },

    "font.sans": { "$value": "{font.family.sans}", "$type": "fontFamily", "$description": "ThemeService 兼容名" },
    "font.mono": { "$value": "{font.family.mono}", "$type": "fontFamily" },

    "glow.blue": { "$value": "{glow.shadow.blue}", "$description": "ThemeService 兼容名" },
    "glow.purple": { "$value": "{glow.shadow.purple}" },
    "glow.mixed": { "$value": "{glow.shadow.mixed}" },

    "flowchat.font.size.xxs": { "$value": "{font.size.xxs}", "$description": "flow-chat 字号镜像（FontPreferenceService 运行时覆盖）" },
    "flowchat.font.size.2xs": { "$value": "{font.size.2xs}" },
    "flowchat.font.size.xs": { "$value": "{font.size.xs}" },
    "flowchat.font.size.sm": { "$value": "{font.size.sm}" },
    "flowchat.font.size.base": { "$value": "{font.size.base}" },
    "flowchat.font.size.lg": { "$value": "{font.size.lg}" },
    "flowchat.font.size.xl": { "$value": "{font.size.xl}" },
    "flowchat.font.size.2xl": { "$value": "{font.size.2xl}" },
    "flowchat.font.size.3xl": { "$value": "{font.size.3xl}" },
    "flowchat.font.size.4xl": { "$value": "{font.size.4xl}" },
    "flowchat.font.size.5xl": { "$value": "{font.size.5xl}" },

    "nav.font.size.xxs": { "$value": "{font.size.xxs}", "$description": "左栏字号基线（比 flow-chat 低一档，FontPreferenceService 运行时覆盖）" },
    "nav.font.size.2xs": { "$value": "{font.size.2xs}" },
    "nav.font.size.xs": { "$value": "{font.size.xs}" },
    "nav.font.size.sm": { "$value": "{font.size.sm}" },
    "nav.font.size.base": { "$value": "{font.size.base}" },
    "nav.font.size.lg": { "$value": "{font.size.lg}" },
    "nav.font.size.xl": { "$value": "{font.size.xl}" },
    "nav.font.size.2xl": { "$value": "{font.size.2xl}" },
    "nav.font.size.3xl": { "$value": "{font.size.3xl}" },
    "nav.font.size.4xl": { "$value": "{font.size.4xl}" },
    "nav.font.size.5xl": { "$value": "{font.size.5xl}" }
  }
}
