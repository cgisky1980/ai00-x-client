{
  "$description": "语义 token（明暗共用一套公式）：全部从 --skin-* 种子经 color-mix 派生。种子由皮肤给出（skins/*.ai00skin.json → src/skin/core.js skinVars）。改公式只改这里后 pnpm build；变量名禁止改动（全仓 scss 依赖）。",
  "color": {
    "bg": {
      "$description": "墨阶 5 级（规范 4.1，v0.12 松烟墨）：base 最深 → sunken 工作区 → card 卡片 → overlay 浮层 → modal 弹窗；hue 240 冷青（松烟墨，与黛青 235 同族一体）；L 定位 ≈ #262a2c 冷墨灰（高级深灰档，兼顾墨色质感与暗色可读性，对标 Notion/Discord 暗度量级）",
      "base": {
        "$value": "var(--skin-bg)",
        "$type": "color"
      },
      "sunken": {
        "$value": "color-mix(in oklab, var(--skin-bg) 50%, var(--skin-surface))",
        "$type": "color"
      },
      "shell": {
        "$value": "var(--skin-deep)",
        "$type": "color"
      },
      "card": {
        "$value": "var(--skin-surface)",
        "$type": "color"
      },
      "overlay": {
        "$value": "color-mix(in oklab, var(--skin-surface) 50%, var(--skin-high))",
        "$type": "color"
      },
      "modal": {
        "$value": "var(--skin-high)",
        "$type": "color"
      },
      "primary": {
        "$value": "{color.bg.base}",
        "$type": "color"
      },
      "secondary": {
        "$value": "{color.bg.sunken}",
        "$type": "color"
      },
      "tertiary": {
        "$value": "{color.bg.card}",
        "$type": "color"
      },
      "quaternary": {
        "$value": "{color.bg.overlay}",
        "$type": "color"
      },
      "elevated": {
        "$value": "{color.bg.modal}",
        "$type": "color"
      },
      "workbench": {
        "$value": "color-mix(in oklab, var(--skin-deep) 50%, var(--skin-bg))",
        "$type": "color"
      },
      "scene": {
        "$value": "color-mix(in oklab, var(--skin-bg) 40%, var(--skin-surface))",
        "$type": "color"
      },
      "flowchat": {
        "$value": "{color.bg.scene}",
        "$type": "color"
      },
      "tooltip": {
        "$value": "{color.bg.modal}",
        "$type": "color"
      }
    },
    "text": {
      "$description": "四级亮度陡峭阶梯（规范 4.5）。primary 0.92 减晕光（halation）+冷白（松烟同域）。muted 0.64 保证 L3 卡片上 ≥3:1（辅助文字档）",
      "primary": {
        "$value": "var(--skin-ink)",
        "$type": "color"
      },
      "secondary": {
        "$value": "color-mix(in oklab, var(--skin-ink) 55%, var(--skin-muted))",
        "$type": "color"
      },
      "muted": {
        "$value": "var(--skin-muted)",
        "$type": "color"
      },
      "disabled": {
        "$value": "color-mix(in oklab, var(--skin-muted) 55%, var(--skin-bg))",
        "$type": "color"
      }
    },
    "accent": {
      "50": {
        "$value": "color-mix(in oklab, var(--skin-mark) 6%, var(--skin-bg))",
        "$type": "color"
      },
      "100": {
        "$value": "color-mix(in oklab, var(--skin-mark) 12%, var(--skin-bg))",
        "$type": "color"
      },
      "200": {
        "$value": "color-mix(in oklab, var(--skin-mark) 22%, var(--skin-bg))",
        "$type": "color"
      },
      "300": {
        "$value": "color-mix(in oklab, var(--skin-accent) 50%, var(--skin-bg))",
        "$type": "color"
      },
      "400": {
        "$value": "color-mix(in oklab, var(--skin-accent) 85%, var(--skin-ink))",
        "$type": "color"
      },
      "500": {
        "$value": "var(--skin-accent)",
        "$type": "color"
      },
      "600": {
        "$value": "color-mix(in oklab, var(--skin-accent) 82%, var(--skin-bg))",
        "$type": "color"
      },
      "700": {
        "$value": "color-mix(in oklab, var(--skin-accent) 70%, var(--skin-bg))",
        "$type": "color"
      },
      "800": {
        "$value": "color-mix(in oklab, var(--skin-accent) 58%, var(--skin-bg))",
        "$type": "color"
      },
      "$description": "签名色·黛青（规范 2.1）：唯一交互色。默认 hue 235；随 --hue/--chroma 运行时调节（web-ui 换肤机制）。基名 --color-accent 在 aliases.json",
      "foreground": {
        "$value": "var(--skin-accent-ink)",
        "$type": "color"
      }
    },
    "brand": {
      "$description": "品牌签名·朱砂印（规范 2.1/2.5）：不随 hue 联动（印章永远是朱的），一屏一处。对比度验证（WCAG）：朱砂对 L1/L3 墨阶 6.67/6.35（正文✓）；CTA 文字用深墨 seal-foreground 6.67 ✓（纸白字仅 2.63 不达标，v0.3 修订）",
      "seal": {
        "$value": "var(--skin-mark)",
        "$type": "color"
      },
      "seal-foreground": {
        "$value": "var(--skin-mark-ink)",
        "$type": "color"
      },
      "seal-hover": {
        "$value": "color-mix(in oklab, var(--skin-mark) 85%, var(--skin-ink))",
        "$type": "color"
      },
      "glyph": {
        "$value": "var(--skin-signature)",
        "$type": "color"
      }
    },
    "purple": {
