{
  "$description": "Ai00-X 设计令牌 · semantic（第二层）· 暗色默认主题「松烟墨」（新东方极简，规范 4.1/4.5/2.1，v0.12）。运行时换肤：色值内嵌 web-ui 三变量公式（var(--hue)/var(--chroma)/var(--chroma-surface)/var(--gray-level) 带默认回退）。墨阶/文字/高亮走 var(--hue-ink, 240)（松烟墨冷青，不随换肤滑杆联动——墨永远是冷的）；黛青走 var(--hue, 235)（滑杆只旋转黛青，规范语义：hue 微调=黛青个人偏好）。朱砂不随 hue 联动。v0.12 调亮墨阶（base L 0.21→0.27）对标 Notion/Discord 高级深灰档。亮色主题见 semantic.light.json。",
  "color": {
    "bg": {
      "$description": "墨阶 5 级（规范 4.1，v0.12 松烟墨）：base 最深 → sunken 工作区 → card 卡片 → overlay 浮层 → modal 弹窗；hue 240 冷青（松烟墨，与黛青 235 同族一体）；L 定位 ≈ #262a2c 冷墨灰（高级深灰档，兼顾墨色质感与暗色可读性，对标 Notion/Discord 暗度量级）",
      "base": { "$value": "oklch(0.27 calc(var(--chroma-surface, 0.012) * 0.5) var(--hue-ink, 240))", "$type": "color", "$description": "L1 app 全局背景（≈ #262a2c）" },
      "sunken": { "$value": "oklch(0.31 calc(var(--chroma-surface, 0.012) * 0.55) var(--hue-ink, 240))", "$type": "color", "$description": "L2 工作区/侧栏" },
      "card": { "$value": "oklch(0.35 calc(var(--chroma-surface, 0.012) * 0.67) var(--hue-ink, 240))", "$type": "color", "$description": "L3 卡片/面板" },
      "overlay": { "$value": "oklch(0.40 calc(var(--chroma-surface, 0.012) * 0.75) var(--hue-ink, 240))", "$type": "color", "$description": "L4 浮层（dropdown/popover）" },
      "modal": { "$value": "oklch(0.45 calc(var(--chroma-surface, 0.012) * 0.85) var(--hue-ink, 240))", "$type": "color", "$description": "L5 弹窗/最高层" },
      "primary": { "$value": "{color.bg.base}", "$type": "color", "$description": "兼容名 → L1" },
      "secondary": { "$value": "{color.bg.sunken}", "$type": "color", "$description": "兼容名 → L2" },
      "tertiary": { "$value": "{color.bg.card}", "$type": "color", "$description": "兼容名 → L3" },
      "quaternary": { "$value": "{color.bg.overlay}", "$type": "color", "$description": "兼容名 → L4" },
      "elevated": { "$value": "{color.bg.modal}", "$type": "color", "$description": "兼容名 → L5（浮层/弹窗/tooltip）" },
      "workbench": { "$value": "oklch(0.21 calc(var(--chroma-surface, 0.012) * 0.4) var(--hue-ink, 240))", "$type": "color", "$description": "工作台编辑区（比 L1 更深半档，沉浸区）" },
      "scene": { "$value": "oklch(0.32 calc(var(--chroma-surface, 0.012) * 0.6) var(--hue-ink, 240))", "$type": "color" },
      "flowchat": { "$value": "{color.bg.scene}", "$type": "color" },
      "tooltip": { "$value": "{color.bg.modal}", "$type": "color" }
    },
    "text": {
      "$description": "四级亮度陡峭阶梯（规范 4.5）。primary 0.92 减晕光（halation）+冷白（松烟同域）。muted 0.64 保证 L3 卡片上 ≥3:1（辅助文字档）",
      "primary": { "$value": "oklch(0.92 calc(var(--chroma-surface, 0.012) * 0.33) var(--hue-ink, 240))", "$type": "color" },
      "secondary": { "$value": "oklch(0.78 calc(var(--chroma-surface, 0.012) * 0.25) var(--hue-ink, 240))", "$type": "color" },
      "muted": { "$value": "oklch(0.64 calc(var(--chroma-surface, 0.012) * 0.06) var(--hue-ink, 240))", "$type": "color" },
      "disabled": { "$value": "oklch(0.48 calc(var(--chroma-surface, 0.012) * 0.04) var(--hue-ink, 240))", "$type": "color" }
    },
    "accent": {
      "$description": "签名色·黛青（规范 2.1）：唯一交互色。默认 hue 235；随 --hue/--chroma 运行时调节（web-ui 换肤机制）。基名 --color-accent 在 aliases.json",
      "foreground": { "$value": "oklch(0.97 0.01 90)", "$type": "color", "$description": "黛青实体底上的文字（纸白，对比 5.69）" },
      "50": { "$value": "oklch(0.96 calc(var(--chroma, 0.12) * 0.05 * (1 - var(--gray-level, 0))) var(--hue, 235))", "$type": "color" },
      "100": { "$value": "oklch(0.92 calc(var(--chroma, 0.12) * 0.12 * (1 - var(--gray-level, 0))) var(--hue, 235))", "$type": "color" },
      "200": { "$value": "oklch(0.85 calc(var(--chroma, 0.12) * 0.28 * (1 - var(--gray-level, 0))) var(--hue, 235))", "$type": "color" },
      "300": { "$value": "oklch(0.78 calc(var(--chroma, 0.12) * 0.50 * (1 - var(--gray-level, 0))) var(--hue, 235))", "$type": "color" },
      "400": { "$value": "oklch(0.72 calc(var(--chroma, 0.12) * 0.72 * (1 - var(--gray-level, 0))) var(--hue, 235))", "$type": "color" },
      "500": { "$value": "oklch(0.70 var(--chroma, 0.12) var(--hue, 235))", "$type": "color", "$description": "黛青基准 oklch(0.70 0.12 235)" },
      "600": { "$value": "oklch(0.62 var(--chroma, 0.12) var(--hue, 235))", "$type": "color" },
      "700": { "$value": "oklch(0.55 calc(var(--chroma, 0.12) * 0.85) var(--hue, 235))", "$type": "color" },
      "800": { "$value": "oklch(0.48 calc(var(--chroma, 0.12) * 0.70) var(--hue, 235))", "$type": "color" }
    },
    "brand": {
      "$description": "品牌签名·朱砂印（规范 2.1/2.5）：不随 hue 联动（印章永远是朱的），一屏一处。对比度验证（WCAG）：朱砂对 L1/L3 墨阶 6.67/6.35（正文✓）；CTA 文字用深墨 seal-foreground 6.67 ✓（纸白字仅 2.63 不达标，v0.3 修订）",
