{
  "$description": "漫画风（comic）风格包 —— 规范第九节。形态语言取自参考站 discuss.flarum.org.cn/extensions 的实测设计语言（『现代网格骨架 + 漫画贴纸细节』的克制派）：暖奶油底 + 暖墨（非纯黑）+ 2px 普遍描边 + 零模糊硬偏移投影阶梯 + 药丸标签 + 虚线分隔 + hover 上浮。映射决策：① 交互色用参考站 coral 系列的深档（#B8461A）而非亮黄——以保证『交互指示对表面 ≥3:1』可机械校验；② 参考站的唯一高亮亮黄 #FFE071 落位到 color.highlight.*（选中/高亮面，配墨框使用）；③ 网点半调纹理按参考站『无网点』取舍，不覆盖纸纹变量，只用统一描边/硬投影/贴纸旋转表达漫画感。base 段=明暗通用形态；light/dark 段=两档配色。",

  "base": {
    "$description": "明暗通用形态（规范 9.4）。全部为『形态变量 / 与模式无关的刻度』，颜色一律引用 token 以便随明暗自动反转。",
    "style": {
      "stroke": {
        "width": { "$value": "2px", "$type": "dimension", "$description": "漫画风全局描边宽度（默认风格为 1px；参考站普遍 2px）" }
      },
      "focus": {
        "ring": { "$value": "{color.text.primary}", "$type": "color", "$description": "焦点环=墨色（明档暖墨 / 暗档暖白），守 3:1" }
      }
    },
    "size": {
      "radius": {
        "$description": "圆角放大到参考站量级：筛选/控件 12px、卡片 15px、hero 19px、标签药丸（radius.full）",
        "sm": { "$value": "10px", "$type": "dimension" },
        "base": { "$value": "12px", "$type": "dimension" },
        "lg": { "$value": "15px", "$type": "dimension" },
        "xl": { "$value": "19px", "$type": "dimension" },
        "2xl": { "$value": "22px", "$type": "dimension" }
      }
    },
    "radius": {
      "$description": "ThemeService 兼容名（必须与 size.radius.* 同步覆盖：ThemeService 会把 --radius-* 与 --size-radius-* 都 inline 写掉）",
      "sm": { "$value": "{size.radius.sm}", "$type": "dimension" },
      "base": { "$value": "{size.radius.base}", "$type": "dimension" },
      "lg": { "$value": "{size.radius.lg}", "$type": "dimension" },
      "xl": { "$value": "{size.radius.xl}", "$type": "dimension" },
      "2xl": { "$value": "{size.radius.2xl}", "$type": "dimension" }
    },
    "shadow": {
      "$description": "硬偏移零模糊投影阶梯（参考站实测：图标 2/3、控件 3/4、卡片 4/5、顶栏 5/6、hero 6/7）。⚠️ 复合值里的引用必须写成显式 var()（构建器的 {ref} 直出只处理『整值就是一个引用』的情形），否则会产出非法 CSS。颜色继承 --color-text-primary，故明档为暖墨、暗档为暖白。",
      "xs": { "$value": "2px 3px 0 var(--color-text-primary)", "$type": "shadow" },
      "sm": { "$value": "3px 4px 0 var(--color-text-primary)", "$type": "shadow" },
      "base": { "$value": "4px 5px 0 var(--color-text-primary)", "$type": "shadow" },
      "lg": { "$value": "5px 6px 0 var(--color-text-primary)", "$type": "shadow" },
      "xl": { "$value": "6px 7px 0 var(--color-text-primary)", "$type": "shadow" },
      "2xl": { "$value": "8px 9px 0 var(--color-text-primary)", "$type": "shadow" }
    },
    "font": {
      "family": {
        "serif": { "$value": "{font.family.sans}", "$type": "fontFamily", "$description": "漫画风的 Display 标题走无衬线（衬线是默认风格的签名，漫画风让位；参考站全站无衬线）" }
      },
      "weight": {
        "$description": "参考站标题用到 800（卡片 h3 20px/800、h1 49px/850），故漫画风把 semibold/bold 上调",
        "semibold": { "$value": "700", "$type": "fontWeight" },
        "bold": { "$value": "800", "$type": "fontWeight" }
      }
    }
  },

