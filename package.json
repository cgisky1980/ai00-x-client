{
  "name": "Ai00-X",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "copy-monaco": "copyfiles -u 5 \"src/web-ui/node_modules/monaco-editor/min/vs/**/*\" src/web-ui/public/monaco-editor",
    "copy-icons": "copyfiles -f \"src/apps/desktop/icons/Logo-ICON.png\" \"src/web-ui/public/\"",
    "copy-assets": "pnpm run copy-monaco && pnpm run copy-icons",
    "generate-version": "node scripts/generate-version.cjs",
    "sync-version": "node scripts/sync-version.cjs",
    "generate-endpoints": "node scripts/generate-endpoints.cjs",
    "generate-all": "pnpm run sync-version && pnpm run generate-endpoints",
    "postinstall": "pnpm run copy-assets",
    "dev": "node scripts/dev.cjs web",
    "dev:web": "pnpm --dir src/web-ui dev",
    "lint:web": "pnpm --dir src/web-ui run lint",
    "lint:web:fix": "pnpm --dir src/web-ui run lint:fix",
    "prebuild": "pnpm run prebuild:web",
    "prebuild:web": "pnpm run copy-assets --silent && pnpm run generate-all --silent",
    "type-check:web": "pnpm --dir src/web-ui run type-check",
    "build": "pnpm run build:web",
    "verify:monaco-assets": "node scripts/verify-monaco-assets.cjs",
    "build:web": "pnpm run type-check:web && pnpm --dir src/web-ui build && pnpm run verify:monaco-assets",
    "build:loader": "pnpm --dir src/loader-ui build",
    "build:loader-zip": "node scripts/zip-dir.mjs dist/loader dist/loader.zip",
    "build:main-zip": "node scripts/zip-dir.mjs dist/main dist/main.zip",
    "build:underlay": "pnpm --dir src/underlay-ui build",
    "build:underlay-zip": "node scripts/zip-dir.mjs dist/underlay dist/underlay.zip",
    "build:all": "pnpm run build:web && pnpm run build:loader && pnpm run build:loader-zip && pnpm run build:main-zip && pnpm run build:underlay && pnpm run build:underlay-zip",
    "dev:loader": "pnpm --dir src/loader-ui dev",
    "preview": "pnpm --dir src/web-ui preview",
    "desktop:dev": "node scripts/dev.cjs desktop",
    "desktop:dev:raw": "cd src/apps/desktop && tauri dev",
    "desktop:build": "node scripts/desktop-tauri-build.mjs",
    "desktop:build:fast": "node scripts/desktop-tauri-build.mjs --debug --no-bundle",
    "desktop:build:release-fast": "node scripts/desktop-tauri-build.mjs --no-bundle -- --profile release-fast",
    "desktop:build:exe": "node scripts/desktop-tauri-build.mjs --no-bundle",
    "desktop:build:nsis": "node scripts/desktop-tauri-build.mjs --bundles nsis",
    "desktop:build:arm64": "node scripts/desktop-tauri-build.mjs --target aarch64-apple-darwin --bundles dmg",
    "desktop:build:x86_64": "node scripts/desktop-tauri-build.mjs --target x86_64-apple-darwin --bundles dmg",
    "desktop:build:linux": "node scripts/desktop-tauri-build.mjs",
    "desktop:build:linux:deb": "node scripts/desktop-tauri-build.mjs --bundles deb",
    "desktop:build:linux:rpm": "node scripts/desktop-tauri-build.mjs --bundles rpm",
    "desktop:build:linux:appimage": "node scripts/desktop-tauri-build.mjs --bundles appimage",
    "preview-components": "pnpm --dir src/web-ui exec vite --config vite.config.preview.ts",
    "build-components": "pnpm --dir src/web-ui exec vite build --config vite.config.preview.ts",
    "models:sync": "uv run scripts/sync-models.py",
    "models:sync:dry": "uv run scripts/sync-models.py --dry-run"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@vitejs/plugin-react": "^4.6.0",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "sass": "^1.93.2",
    "sharp": "^0.34.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b",
  "dependencies": {
    "pnpm": "^10.32.1",
    "pptxgenjs": "^4.0.1"
  }
}
